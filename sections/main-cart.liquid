<section class="commerce-page commerce-cart-page" aria-labelledby="CartTitle-{{ section.id }}">
  <div class="container">
    <div class="commerce-page-heading"><div class="eyebrow">TWOJA ŚCIEŻKA</div><h1 id="CartTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1></div>
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}" class="commerce-cart-form">
        <div class="commerce-cart-layout">
          <ul class="commerce-cart-items" aria-label="Produkty w koszyku">
            {% for item in cart.items %}
              <li class="commerce-cart-item">
                <a href="{{ item.url }}" class="commerce-cart-image" aria-label="Zobacz produkt: {{ item.product.title | escape }}">
                  {% if item.image %}{% assign image_alt = item.image.alt | default: item.product.title %}{{ item.image | image_url: width: 300 | image_tag: widths: '120,200,300', sizes: '120px', loading: 'lazy', alt: image_alt }}{% else %}<span class="commerce-image-placeholder" aria-hidden="true">{% render 'icon', name: 'layers-3' %}</span>{% endif %}
                </a>
                <div class="commerce-cart-details">
                  <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                  {% unless item.product.has_only_default_variant %}<p class="commerce-cart-variant">{{ item.variant.title | escape }}</p>{% endunless %}
                  {% if item.selling_plan_allocation %}<p class="commerce-cart-plan">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                  {% if item.properties.size > 0 %}
                    <dl class="commerce-cart-properties">
                      {% for property in item.properties %}
                        {% assign first_character = property.first | slice: 0 %}
                        {% if property.last != blank and first_character != '_' %}
                          <div><dt>{{ property.first | escape }}:</dt><dd>{% assign property_prefix = property.last | slice: 0, 8 %}{% if property_prefix == 'https://' and property.last contains '/uploads/' %}<a href="{{ property.last | escape }}" target="_blank" rel="noopener noreferrer">{{ property.last | split: '/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</dd></div>
                        {% endif %}
                      {% endfor %}
                    </dl>
                  {% endif %}
                  <div class="commerce-cart-unit-price">
                    {% if item.original_price != item.final_price %}<s><span class="sr-only">Cena przed rabatem: </span>{{ item.original_price | money_with_currency }}</s>{% endif %}
                    <span>{{ item.final_price | money_with_currency }} / szt.</span>
                  </div>
                  {% if item.line_level_discount_allocations.size > 0 %}<ul class="commerce-discounts" aria-label="Rabaty produktu">{% for allocation in item.line_level_discount_allocations %}<li>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money_with_currency }})</li>{% endfor %}</ul>{% endif %}
                  <a href="{{ item.url_to_remove }}" class="commerce-remove-link" aria-label="Usuń produkt: {{ item.product.title | escape }}">Usuń</a>
                </div>
                <div class="commerce-cart-quantity commerce-field">
                  <label for="CartQuantity-{{ section.id }}-{{ forloop.index }}">Ilość<span class="sr-only"> — {{ item.product.title | escape }}</span></label>
                  <input id="CartQuantity-{{ section.id }}-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="{{ item.variant.quantity_rule.min | default: 1 }}" step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %} inputmode="numeric" aria-label="Ilość: {{ item.product.title | escape }}" aria-describedby="CartQuantityHelp-{{ section.id }}-{{ forloop.index }}">
                  <p id="CartQuantityHelp-{{ section.id }}-{{ forloop.index }}" class="commerce-field-help">Aby usunąć produkt, wybierz „Usuń”.</p>
                </div>
                <div class="commerce-cart-line-total"><span class="commerce-total-label">Razem</span>{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money_with_currency }}</s>{% endif %}<strong>{{ item.final_line_price | money_with_currency }}</strong></div>
              </li>
            {% endfor %}
          </ul>
          <aside class="commerce-cart-summary" aria-labelledby="CartSummary-{{ section.id }}">
            <h2 id="CartSummary-{{ section.id }}">Podsumowanie</h2>
            {% if cart.cart_level_discount_applications.size > 0 %}<ul class="commerce-discounts" aria-label="Rabaty zamówienia">{% for discount in cart.cart_level_discount_applications %}<li>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money_with_currency }}</span></li>{% endfor %}</ul>{% endif %}
            <div class="commerce-cart-total"><span>Suma</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
            <p class="commerce-tax-note">{% if cart.taxes_included %}Cena zawiera podatki.{% else %}Ewentualne podatki zostaną obliczone w kasie.{% endif %}{% if cart.requires_shipping %} Koszty dostawy zostaną obliczone w kasie.{% endif %}</p>
            <button type="submit" name="update" class="button button-outline commerce-cart-update">Zaktualizuj koszyk</button>
            <button type="submit" name="checkout" class="button button-primary commerce-checkout">Przejdź do kasy {% render 'icon', name: 'arrow-up-right' %}</button>
            <p class="commerce-field-help">Zamówienie i płatność potwierdzisz w bezpiecznej kasie Shopify.</p>
            <a href="{{ routes.all_products_collection_url }}" class="commerce-text-link">Kontynuuj zakupy</a>
          </aside>
        </div>
      </form>
    {% else %}
      <div class="commerce-empty-state"><h2>Twój koszyk jest jeszcze pusty.</h2><p>Znajdź produkt dopasowany do swojego etapu i zacznij od konkretnego kroku.</p><a href="{{ routes.all_products_collection_url }}" class="button button-primary">Zobacz produkty {% render 'icon', name: 'arrow-up-right' %}</a></div>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Koszyk", "settings": [{ "type": "text", "id": "heading", "label": "Nagłówek", "default": "Twój koszyk." }] }
{% endschema %}
