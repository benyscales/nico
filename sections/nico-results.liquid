<section id="wyniki" class="section results-section">
  <div class="container">
    <div class="section-heading split-heading" data-reveal>
      <div><p class="eyebrow"><span class="section-number">{{ section.settings.number | escape }} /</span>{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}<br><span class="muted-heading">{{ section.settings.heading_muted | escape }}</span></h2></div>
      <p>{{ section.settings.description | escape | newline_to_br }}</p>
    </div>
    <div class="results-grid" data-reveal>
      {% for block in section.blocks %}
        <article class="result-card{% if block.settings.visual == 'process' %} result-connection{% endif %}" {{ block.shopify_attributes }}>
          <span class="result-topline">
            {% case block.settings.visual %}
              {% when 'sales' %}<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag" aria-hidden="true"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg>
              {% when 'process' %}<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-route" aria-hidden="true"><circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle></svg>
              {% else %}<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-video" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"></path><rect x="2" y="6" width="14" height="12" rx="2"></rect></svg>
            {% endcase %}
            <span>{{ block.settings.label | escape }}</span>
          </span>
          {% if block.settings.visual == 'process' %}
            <div class="result-flow">{{ block.settings.flow_start | escape }} <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><br><span>{{ block.settings.flow_end | escape }}</span></div>
          {% else %}
            <div class="result-number">{{ block.settings.value | escape }}<span>{{ block.settings.suffix | escape }}</span></div>
          {% endif %}
          <h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.description | escape }}</p>
          {% case block.settings.visual %}
            {% when 'views' %}<div class="result-bars" aria-hidden="true"><span style="height:22%"></span><span style="height:34%"></span><span style="height:29%"></span><span style="height:46%"></span><span style="height:38%"></span><span style="height:57%"></span><span style="height:49%"></span><span style="height:68%"></span><span style="height:59%"></span><span style="height:78%"></span><span style="height:71%"></span><span style="height:92%"></span><span style="height:85%"></span><span style="height:100%"></span><span style="height:93%"></span></div>
            {% when 'sales' %}<div class="result-product-icons" aria-hidden="true"><span><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg></span><span><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></span><span><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></span><span><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></span></div>
          {% endcase %}
        </article>
      {% endfor %}
    </div>
    <p class="results-note">{{ section.settings.note | escape }}</p>
  </div>
</section>
{% schema %}
{
  "name": "NICO — Wyniki",
  "tag": "div",
  "class": "nico-results-wrapper",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Numer sekcji",
      "default": "01"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Nadtytuł",
      "default": "DOŚWIADCZENIE, NIE OBIETNICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Nie zaczynam od teorii."
    },
    {
      "type": "text",
      "id": "heading_muted",
      "label": "Druga linia nagłówka",
      "default": "Zaczynam od praktyki."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Opis sekcji",
      "default": "Za tym, czego uczę, stoją treści,\nprodukty i realne działanie."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Dopisek o wynikach",
      "default": "Moje dotychczasowe wyniki. Twój rozwój zależy od Twojego projektu, rynku i działania."
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Wynik lub proces",
      "settings": [
        {
          "type": "select",
          "id": "visual",
          "label": "Rodzaj karty",
          "options": [
            {
              "value": "views",
              "label": "Wyświetlenia — wykres"
            },
            {
              "value": "sales",
              "label": "Sprzedaż — produkty"
            },
            {
              "value": "process",
              "label": "Proces — content i sprzedaż"
            }
          ],
          "default": "views"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etykieta",
          "default": "ZASIĘG"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Wartość",
          "default": "70M"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Przyrostek",
          "default": "+"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Tytuł karty",
          "default": "Wyświetleń na platformach"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Opis karty",
          "default": "Doświadczenie w tworzeniu treści, które docierają do odbiorców."
        },
        {
          "type": "text",
          "id": "flow_start",
          "label": "Proces — początek",
          "default": "Content"
        },
        {
          "type": "text",
          "id": "flow_end",
          "label": "Proces — koniec",
          "default": "Sprzedaż"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NICO — Wyniki",
      "blocks": [
        {
          "type": "result",
          "settings": {
            "visual": "views",
            "label": "ZASIĘG",
            "value": "70M",
            "suffix": "+",
            "heading": "Wyświetleń na platformach",
            "description": "Doświadczenie w tworzeniu treści, które docierają do odbiorców.",
            "flow_start": "Content",
            "flow_end": "Sprzedaż"
          }
        },
        {
          "type": "result",
          "settings": {
            "visual": "sales",
            "label": "SPRZEDAŻ",
            "value": "1000",
            "suffix": "+",
            "heading": "Sprzedanych produktów cyfrowych",
            "description": "Praktyczne doświadczenie w sprzedaży produktów w internecie.",
            "flow_start": "Content",
            "flow_end": "Sprzedaż"
          }
        },
        {
          "type": "result",
          "settings": {
            "visual": "process",
            "label": "PROCES",
            "value": "70M",
            "suffix": "+",
            "heading": "Od uwagi do klienta",
            "description": "Łączenie tworzenia treści z monetyzacją i rozwojem biznesu.",
            "flow_start": "Content",
            "flow_end": "Sprzedaż"
          }
        }
      ]
    }
  ]
}
{% endschema %}
