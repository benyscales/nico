{%- assign form_id = 'ContactForm-' | append: section.id -%}
<section class="legal-page contact-page">
  <div class="container page-container">
    <a class="eyebrow" href="{{ routes.root_url }}">← {{ settings.brand_name | default: 'NICO' | escape }} / Strona główna</a>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="form-intro">{{ section.settings.intro | escape | newline_to_br }}</p>
    {% if page.content != blank %}<div class="rte page-content">{{ page.content }}</div>{% endif %}
    <div class="consultation-form">
      {% form 'contact', id: form_id, class: 'native-contact-form' %}
        {% if form.posted_successfully? %}
          <div class="form-status success" role="status" tabindex="-1">
            {% render 'icon', name: 'check-circle' %}
            <p>Wiadomość została wysłana. Odpowiemy na podany adres e-mail. Zgłoszenie nie jest rezerwacją terminu konsultacji.</p>
          </div>
        {% endif %}
        {% if form.errors %}
          <div id="{{ form_id }}-errors" class="form-status error" role="alert" tabindex="-1">
            {% render 'icon', name: 'circle-alert' %}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {% endif %}
        <div class="form-row">
          <div class="form-field">
            <label for="{{ form_id }}-name">Imię lub pseudonim <span aria-hidden="true">*</span></label>
            <input id="{{ form_id }}-name" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required maxlength="80" placeholder="Jak się do Ciebie zwracać?">
          </div>
          <div class="form-field">
            <label for="{{ form_id }}-email">Adres e-mail <span aria-hidden="true">*</span></label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required maxlength="254" placeholder="twoj@email.pl"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}>
          </div>
        </div>
        <div class="form-field">
          <label for="{{ form_id }}-body">Nad czym chcesz pracować? <span aria-hidden="true">*</span></label>
          <textarea id="{{ form_id }}-body" name="contact[body]" rows="6" required minlength="10" maxlength="2000" placeholder="Twój pomysł, wyzwanie lub cel…"{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}>{{ form.body | escape }}</textarea>
        </div>
        <label class="consent-label" for="{{ form_id }}-consent">
          <input id="{{ form_id }}-consent" type="checkbox" name="contact[Zgoda na kontakt]" value="Proszę o kontakt e-mail w sprawie mojego zgłoszenia." required>
          <span>Proszę o kontakt e-mail w sprawie mojego zgłoszenia.{% if shop.privacy_policy.body != blank %} Zapoznałem/am się z <a href="{{ shop.privacy_policy.url }}">informacją o prywatności</a>.{% endif %}</span>
        </label>
        <button class="button button-primary form-submit" type="submit">Wyślij wiadomość {% render 'icon', name: 'arrow-up-right' %}</button>
        <p class="form-footnote">Pola oznaczone * są wymagane. Zgłoszenie nie rezerwuje terminu i nie zapisuje Cię na newsletter.</p>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formularz kontaktowy",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zacznijmy od rozmowy." },
    { "type": "textarea", "id": "intro", "label": "Wprowadzenie", "default": "Opowiedz krótko o swoim pomyśle lub napisz w sprawie produktów i indywidualnej współpracy. Szczegóły rozmowy ustalimy po kontakcie." }
  ]
}
{% endschema %}
