<section id="jak-pomagam" class="section audience-section"><div class="container">
  <div class="section-heading centered" data-reveal><p class="eyebrow"><span class="section-number">{{ section.settings.number | escape }} /</span>{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}<br><span class="muted-heading">{{ section.settings.heading_muted | escape }}</span></h2><p>{{ section.settings.description | escape | newline_to_br }}</p></div>
  <div class="audience-grid" data-reveal>
    {% for block in section.blocks %}
      {% assign card_url = block.settings.url | default: '#produkty' %}
      <a class="audience-card" href="{{ card_url | escape }}" {{ block.shopify_attributes }}>
        <div class="audience-card-top"><span class="audience-icon">
          {% case block.settings.icon %}
            {% when 'video' %}<svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-video" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"></path><rect x="2" y="6" width="14" height="12" rx="2"></rect></svg>
            {% when 'mouse-pointer-2' %}<svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mouse-pointer-2" aria-hidden="true"><path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"></path></svg>
            {% when 'trending-up' %}<svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>
            {% else %}<svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>
          {% endcase %}
        </span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right audience-arrow" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></div>
        <span class="card-micro-label">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }} <span>/</span> {{ block.settings.label | escape }}</span>
        <h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.description | escape }}</p>
      </a>
    {% endfor %}
  </div>
</div></section>
{% schema %}
{
  "name": "NICO — Dla kogo",
  "tag": "div",
  "class": "nico-audience-wrapper",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Numer sekcji",
      "default": "02"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Nadtytuł",
      "default": "TWÓJ PUNKT STARTOWY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Nie musisz wiedzieć wszystkiego,"
    },
    {
      "type": "text",
      "id": "heading_muted",
      "label": "Druga linia nagłówka",
      "default": "żeby zacząć."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Opis sekcji",
      "default": "Potrzebujesz konkretnego kierunku, sprawdzonego procesu\ni wiedzy, którą możesz wykorzystać w praktyce."
    }
  ],
  "blocks": [
    {
      "type": "audience",
      "name": "Punkt startowy",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikona",
          "options": [
            {
              "value": "lightbulb",
              "label": "Pomysł"
            },
            {
              "value": "video",
              "label": "Content"
            },
            {
              "value": "mouse-pointer-2",
              "label": "Sprzedaż"
            },
            {
              "value": "trending-up",
              "label": "Rozwój"
            }
          ],
          "default": "lightbulb"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etykieta",
          "default": "OD POMYSŁU"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Tytuł",
          "default": "Chcę zacząć od zera"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Opis",
          "default": "Znajdź pomysł na produkt lub usługę i poznaj podstawy budowania biznesu online."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Odnośnik",
          "info": "Puste pole prowadzi do sekcji produktów na stronie głównej."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NICO — Dla kogo",
      "blocks": [
        {
          "type": "audience",
          "settings": {
            "icon": "lightbulb",
            "label": "OD POMYSŁU",
            "heading": "Chcę zacząć od zera",
            "description": "Znajdź pomysł na produkt lub usługę i poznaj podstawy budowania biznesu online."
          }
        },
        {
          "type": "audience",
          "settings": {
            "icon": "video",
            "label": "DO UWAGI",
            "heading": "Chcę tworzyć lepszy content",
            "description": "Naucz się przyciągać uwagę odbiorców i budować rozpoznawalność."
          }
        },
        {
          "type": "audience",
          "settings": {
            "icon": "mouse-pointer-2",
            "label": "DO PIERWSZYCH KLIENTÓW",
            "heading": "Chcę zacząć sprzedawać",
            "description": "Poznaj podstawy oferty, komunikacji z klientem i procesu sprzedaży."
          }
        },
        {
          "type": "audience",
          "settings": {
            "icon": "trending-up",
            "label": "I DALEJ",
            "heading": "Chcę rozwijać swój biznes",
            "description": "Uporządkuj działania, popraw content i szukaj sposobów na zwiększenie sprzedaży."
          }
        }
      ]
    }
  ]
}
{% endschema %}
