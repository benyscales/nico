{%- assign password_form_id = 'PasswordForm-' | append: section.id -%}
<section class="legal-page password-page">
  <div class="container page-container">
    <p class="eyebrow">{{ settings.brand_name | default: 'NICO' | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if shop.password_message != blank %}
      <p>{{ shop.password_message | escape | newline_to_br }}</p>
    {% else %}
      <p>{{ section.settings.intro | escape }}</p>
    {% endif %}
    {% form 'storefront_password', id: password_form_id, class: 'password-form' %}
      {% if form.errors %}
        <div id="{{ password_form_id }}-errors" class="form-status error" role="alert">
          {% render 'icon', name: 'circle-alert' %}
          <div>{{ form.errors | default_errors }}</div>
        </div>
      {% endif %}
      <div class="form-field">
        <label for="{{ password_form_id }}-password">Hasło dostępu do sklepu</label>
        <input id="{{ password_form_id }}-password" type="password" name="password" autocomplete="current-password" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ password_form_id }}-errors"{% endif %}>
      </div>
      <button class="button button-primary form-submit" type="submit">Wejdź do sklepu {% render 'icon', name: 'lock' %}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Dostęp do sklepu",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Wkrótce zaczynamy." },
    { "type": "textarea", "id": "intro", "label": "Wprowadzenie", "default": "Sklep jest obecnie chroniony hasłem. Jeśli masz hasło dostępu, wpisz je poniżej." }
  ]
}
{% endschema %}
